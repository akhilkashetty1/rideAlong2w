# Two Wheeler Ride Along — environment variables
# Copy to .env.local for local dev; set the same in Vercel → Settings → Environment Variables.
# Every value is optional: without them the form still writes to the existing Google Sheet,
# exactly as the old Render backend did.

# --- Google Sheet (Apps Script Web App) ---
# Defaults to the Sheet the Render backend used.
GOOGLE_SHEET_WEBAPP_URL=

# --- Brevo notification email ---
# Use a NEW key — the one in rideAlongBackend's git history must be revoked.
BREVO_API_KEY=
# Defaults: ridealongform.project@gmail.com / RideAlongForm → ridealongform@gmail.com
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
ADMIN_EMAIL_PRIMARY=
ADMIN_EMAIL_CC=

# --- Submissions hub (database + admin login, submissions-hub repo) ---
# e.g. https://<hub-domain>/api/ingest/2w — the key is the hub's INGEST_KEY_2W
HUB_INGEST_URL=
HUB_INGEST_KEY=
